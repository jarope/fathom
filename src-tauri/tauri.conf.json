{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fathom",
  "version": "0.35.2",
  "identifier": "uk.jrpc.fathom",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fathom",
        "width": 1180,
        "height": 820,
        "minWidth": 820,
        "minHeight": 560,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 34
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "copyright": "© 2026 Jason Peel. Free software under the GNU GPL v3 or later.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyOUUwQTNBQkZDNjc0RTAKUldUZ2RNYS9PZ3FlSWhFMnpkNVhvMVhWTW1KZFJTTDFkRXkwc2daK2xpU25xSUhkYzVvaFpWTzAK",
      "endpoints": [
        "https://github.com/jarope/fathom/releases/latest/download/latest.json"
      ]
    }
  }
}
